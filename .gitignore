# --- Manuscript and correspondence: NEVER commit -----------------------------
# This repository is intended to be shared with reviewers. Manuscript drafts,
# cover letters and editorial correspondence must stay out of it.
*.docx
*.doc
*.odt
*.pdf
~$*
rev*/

# --- Large / derived model objects -------------------------------------------
# Model fits and posterior objects are reproducible from the scripts and the
# data in data/. They are cached locally but not versioned.
outputs/*.rds
*.RData
*.Rdata
# ...except the input bundle, which is data, not a derived object.
!data/diver_owf_data.RData

# --- Scratch ------------------------------------------------------------------
*.tmp
outputs/*.tmp

# --- Archive ------------------------------------------------------------------
# Scripts kept locally but not part of the published analysis: the 2022
# distance calculation, and the environmental-covariate work that is not used
# in the manuscript. Nothing here is needed to reproduce a reported number.
archive/

# --- R session cruft ----------------------------------------------------------
.Rhistory
.Rapp.history
.Rproj.user/
.Renviron
.Rprofile

# --- OS cruft -----------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Vendored packages --------------------------------------------------------
inlabru/
inlabru.zip
.positai

# --- Environmental covariate layers ------------------------------------------
# Third-party EMODnet products and anything derived from them. Large, and
# available from their own sources; see R/covariate_paths.R for the location
# and R/download_emodnet_covariates.R for how to obtain them.
covariates/
data/bathymetry*.tif
data/slope_region.tif
data/substrate_folk5.gpkg
data/euseamap_habitat.gpkg
data/vessel_density.tif
data/coastline.gpkg
data/sst.tif
data/chla.tif
